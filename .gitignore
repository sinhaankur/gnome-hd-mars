# ---- rights-restricted disc content (see CREDITS.md / LICENSE) ----
# Original 1997 G-NOME disc image and everything extracted from it stays local:
# © 7th Level, Inc. — and far over GitHub's 100 MB file limit anyway.
# (patterns anchored with "/" so they only match at the repo root —
#  an unanchored "assets/" would wrongly swallow godot/assets/ too)
/G-NOME.bin
/G-NOME.cue
/extracted/
/cinematics/
/audio/
/assets/
# original 1997 game program files (G-NOME.EXE/BIN, RENDER.R32, LABTEXT.DAT)
# © 7th Level, Inc. — not ours to redistribute
/game/

# ---- re-derivable bulk data ----
# raw NASA HiRISE/MOLA downloads — re-fetch via tools/hirise_regions.py
/mars_data/
# user-supplied reference mechs, license unverified (do not distribute)
/Glb/
/w9231-combat-mech-rigged/
/w9231_combat_mech_rigged-2.glb
# raw CC-BY mech source dump (the game only ships the baked .glb in godot/assets/)
/bot-mecha-warrior-3d-by-oscar-creativo/
/design/bot_mecha_warrior_3d_by_oscar_creativo.glb
# vendored MIT repo — re-clone from ra100/blender-claude-plugin
tools/addons/blender-claude-plugin

# ---- caches / OS noise ----
godot/.godot/
.DS_Store
**/.DS_Store

# transient art-pass captures — regenerated every DEV_SHOTS run
/reference/shots/

# raw NASA/PDS rover XYZ downloads — re-fetch via tools (public domain, large)
/mars_data/rover_xyz/*.IMG
/mars_data/rover_xyz/*.obj

# Godot GLTF texture-extraction artifacts (regenerated on import)
godot/assets/imported/*_mars.webp
godot/mars_data/

# secrets
sketchfab_token
*.token

# raw Sketchfab source downloads (large; re-fetch via tools/sketchfab_download.py)
blender_assets/sketchfab_src/*.glb
